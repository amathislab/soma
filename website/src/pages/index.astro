---
import { Font } from "astro:assets";

import Header from "../components/Header.astro";
import epflLogo from "../assets/epfl-logo.svg";

import "../styles/global.css";

const title =
  "SOMA: A Benchmark for Fine-Grained Egocentric Behavior and Body-Motion Understanding";
const description =
  "A video-language benchmark for fine-grained body-motion understanding in egocentric video.";

const theme: "device" | "light" | "dark" = "device";

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
---

<!doctype html>
<html class="bg-white dark:bg-zinc-900" lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" href={prefix + "favicon.png"} />
    <link rel="apple-touch-icon" href={prefix + "favicon.png"} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <Font
      cssVariable="--font-noto-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />

    <title>{title}</title>
  </head>
  <body
    class="prose prose-lg prose-zinc dark:prose-invert prose-a:text-blue-600 prose-a:hover:text-blue-900 prose-a:dark:text-blue-200 prose-a:dark:hover:text-blue-100 prose-a:underline prose-a:decoration-dashed prose-a:underline-offset-4 prose-a:hover:decoration-solid prose-a:font-normal flex min-h-svh max-w-none flex-col pb-6 font-(family-name:--font-noto-sans)"
  >
    <main class="flex flex-1 flex-col justify-center py-16 [&>header]:mb-0">
      <Header
        title='SOMA: A Benchmark for <span style="white-space:nowrap">Fine-Grained</span> Egocentric Behavior and <span style="white-space:nowrap">Body-Motion</span> Understanding'
        authors={[
          { name: "Matea Tashkovska", url: "https://people.epfl.ch/matea.tashkovska" },
          { name: "Naël Ouerghemi", url: "https://people.epfl.ch/nael.ouerghemi" },
          { name: "Haozhe Qi", url: "https://scholar.google.com/citations?user=BajLgxUAAAAJ" },
          { name: "Alexander Mathis", url: "https://people.epfl.ch/alexander.mathis" },
        ]}
        links={[
          { name: "Paper (arXiv)", url: "#", icon: "academicons:arxiv" },
          { name: "Project repository", url: "https://github.com/amathislab/soma", icon: "ri:github-line" },
          { name: "Dataset", url: "https://huggingface.co/datasets/amathislab/SOMA", icon: "ri:database-2-line" },
        ]}
      >
        <div class="not-prose mb-4 flex flex-col items-center gap-3">
          <a
            href="https://cnai.epfl.ch/"
            class="text-xl text-zinc-800 hover:underline hover:underline-offset-4 dark:text-zinc-100"
          >
            Mathis Group of Computational Neuroscience &amp; AI
          </a>
          <a href="https://www.epfl.ch/" aria-label="EPFL">
            <img src={epflLogo.src} alt="EPFL" class="h-6 w-auto" />
          </a>
        </div>

        <div slot="after-links" class="not-prose mt-4 flex justify-center">
          <span
            class="rounded-full border-2 border-zinc-800 px-5 py-2 text-lg text-zinc-800 dark:border-zinc-200 dark:text-zinc-200"
          >
            Coming soon
          </span>
        </div>
      </Header>
    </main>

    <footer
      class="-mb-6 bg-zinc-50 py-4 text-center dark:bg-zinc-800/50"
    >
      <p class="prose-sm mx-auto max-w-[50rem] px-6 text-center text-zinc-500 dark:text-zinc-400">
        This website was adapted from <a
          href="https://github.com/RomanHauksson/academic-project-astro-template"
          rel="nofollow">the following source code</a
        >.
      </p>
    </footer>
  </body>
</html>
