---
import { readFileSync } from "node:fs";

interface Props {
  name: string;
}

const { name } = Astro.props;

const PRETTY: Record<string, string> = {
  bilateral_hand_roles: "Bimanual Coordination",
  hand_use: "Hand Use",
  body_posture: "Body Posture",
  concurrent_body_state: "Concurrent Body-Part State",
  motion_repetition_counting: "Repetition Counting",
  direction_turning_navigation: "Movement Direction",
  opposite_motion_discrimination: "Opposite Motion Discrimination",
  before_after_ordering: "Adjacent Action Identification",
  motion_sequence_ordering: "Chronological Ordering",
  missing_event_detection: "Missing Event Inference",
  next_step_prediction: "Next Action Prediction",
  repeated_event_reasoning: "Repeated Event Reasoning",
};

const panel = JSON.parse(
  readFileSync(`${process.cwd()}/public/pose/${name}.panel.json`, "utf8"),
) as {
  question: {
    category: string;
    question: string;
    options: Record<string, string>;
    answer_letter: string;
  };
  views: { label: string }[];
};
const q = panel.question;

const base = import.meta.env.BASE_URL;
const prefix = base.endsWith("/") ? base : base + "/";
---

<figure
  class="pose-panel not-prose my-10"
  data-src={`${prefix}pose/${name}.panel.json`}
>
  <div class="grid gap-2 sm:grid-cols-[2fr_1fr]">
    <div class="media group relative">
      <video
        class="block aspect-square w-full rounded-lg bg-zinc-100 object-cover dark:bg-zinc-800"
        src={`${prefix}pose/${name}.mp4`}
        poster={`${prefix}pose/${name}.jpg`}
        loop
        muted
        playsinline
        preload="none"></video>
      <button type="button" class="play-btn absolute inset-0 grid place-items-center" aria-label="Play clip">
        <span class="grid h-14 w-14 place-items-center rounded-full bg-black/45 text-white shadow-lg backdrop-blur-sm transition group-hover:bg-black/60">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </span>
      </button>
    </div>
    <div class="pose-views grid grid-cols-2 gap-2 sm:grid-cols-1">
      {
        panel.views.map((view) => (
          <div class="relative overflow-hidden rounded-lg bg-zinc-100 dark:bg-zinc-800">
            <canvas class="block aspect-square w-full" />
            <span class="absolute bottom-2 left-2.5 text-[0.8rem] font-medium text-zinc-400 dark:text-zinc-500">
              {view.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <figcaption class="mt-5">
    <p
      class="text-[0.95rem] font-semibold text-zinc-500 dark:text-zinc-400"
    >
      {PRETTY[q.category] ?? q.category}
    </p>
    <p class="mt-2 text-[1.05rem] leading-snug font-medium text-zinc-900 dark:text-zinc-50">
      {q.question}
    </p>
    <ul class="pose-options grid pt-4 gap-x-6 gap-y-1.5 sm:grid-cols-2">
      {
        ["A", "B", "C", "D"].map((letter) => (
          <li
            class="flex items-baseline gap-2.5 text-[0.95rem] leading-snug text-zinc-700 dark:text-zinc-300"
            data-correct={letter === q.answer_letter ? "" : undefined}
          >
            <span class="w-3 shrink-0 text-zinc-400 dark:text-zinc-500">{letter}</span>
            <span class="flex-1">{q.options[letter] ?? ""}</span>
            <span class="tick shrink-0 text-teal-600 opacity-0 dark:text-teal-400">&#10003;</span>
          </li>
        ))
      }
    </ul>
    <button
      type="button"
      class="pose-reveal mt-4 text-sm text-zinc-500 underline decoration-zinc-300 decoration-dashed underline-offset-4 transition-colors hover:text-zinc-800 hover:decoration-solid dark:text-zinc-400 dark:decoration-zinc-600 dark:hover:text-zinc-100"
    >
      Show answer
    </button>
  </figcaption>

</figure>

<style>
  .play-btn {
    transition: opacity 150ms ease;
  }
  .media.playing .play-btn {
    opacity: 0;
    pointer-events: none;
  }

  .pose-options li {
    transition:
      color 200ms ease,
      opacity 200ms ease;
  }
  .pose-options.revealed li:not([data-correct]) {
    opacity: 0.45;
  }
  .pose-options.revealed li[data-correct] {
    font-weight: 600;
  }
  .pose-options.revealed li[data-correct] .tick {
    opacity: 1;
  }
</style>

<script>
  type View = {
    kind: "ego" | "orbit";
    lens_radius?: number;
    frames: number[][];
  };
  type Panel = {
    fps: number;
    n_frames: number;
    n_joints: number;
    bones: [number, number, string][];
    colors: Record<string, string>;
    views: View[];
  };

  for (const root of document.querySelectorAll<HTMLElement>(".pose-panel")) {
    const video = root.querySelector("video")!;
    const viewsHost = root.querySelector<HTMLElement>(".pose-views")!;
    const optionsHost = root.querySelector<HTMLElement>(".pose-options")!;
    const reveal = root.querySelector<HTMLButtonElement>(".pose-reveal")!;
    const media = root.querySelector<HTMLElement>(".media")!;
    const playBtn = root.querySelector<HTMLButtonElement>(".play-btn")!;

    let panel: Panel | null = null;
    let canvases: { view: View; ctx: CanvasRenderingContext2D; size: number }[] = [];
    let lastFrame = -1;

    function buildViews(data: Panel) {
      const cells = viewsHost.querySelectorAll("canvas");
      canvases = data.views.map((view, i) => ({
        view,
        ctx: cells[i].getContext("2d")!,
        size: 0,
      }));
      resize();
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      for (const c of canvases) {
        const canvas = c.ctx.canvas;
        const box = canvas.getBoundingClientRect();
        if (!box.width) continue;
        c.size = box.width;
        canvas.width = Math.round(box.width * dpr);
        canvas.height = Math.round(box.height * dpr);
        c.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      lastFrame = -1;
    }

    function drawView(
      c: { view: View; ctx: CanvasRenderingContext2D; size: number },
      frameIndex: number,
    ) {
      const { ctx, size, view } = c;
      const flat = view.frames[frameIndex];
      if (!flat || !size || !panel) return;
      ctx.clearRect(0, 0, size, size);

      const px = (i: number) => flat[i * 3] * size;
      const py = (i: number) => flat[i * 3 + 1] * size;
      const raw = (i: number) => flat[i * 3 + 2];
      const dep = (i: number) => Math.abs(raw(i));
      const shown = (i: number) => raw(i) > 0;
      const ego = view.kind === "ego";
      const weight = ego ? 0.006 : 0.03;
      const maxWidth = size * (ego ? 0.022 : 0.04);

      if (ego) {
        ctx.save();
        ctx.strokeStyle = "rgba(113,113,122,0.3)";
        ctx.setLineDash([3, 3]);
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(size / 2, size / 2, (view.lens_radius ?? 0.275) * size, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      } else {
        const fx = (px(17) + px(21)) / 2;
        const fy = (py(17) + py(21)) / 2;
        const fd = (dep(17) + dep(21)) / 2;
        ctx.save();
        ctx.globalAlpha = 0.1;
        ctx.fillStyle = "#000";
        ctx.beginPath();
        ctx.ellipse(fx, fy + size * 0.012, (size * 0.1) / fd, (size * 0.028) / fd,
          0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      const order = panel.bones
        .map((b, i) => [i, (dep(b[0]) + dep(b[1])) / 2] as const)
        .sort((a, b) => b[1] - a[1]);

      ctx.lineCap = "round";
      for (const [i] of order) {
        const [a, b, group] = panel.bones[i];
        if (raw(a) === 0 || raw(b) === 0) continue;
        ctx.globalAlpha = !ego || shown(a) || shown(b) ? 1 : 0.22;
        ctx.strokeStyle = panel.colors[group] ?? "#64748b";
        ctx.lineWidth = Math.min(
          maxWidth, Math.max(1.5, (size * weight) / ((dep(a) + dep(b)) / 2)));
        ctx.beginPath();
        ctx.moveTo(px(a), py(a));
        ctx.lineTo(px(b), py(b));
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      ctx.fillStyle = "rgba(24,24,27,0.7)";
      for (let i = 0; i < panel.n_joints; i++) {
        if (ego ? raw(i) === 0 : !shown(i)) continue;
        ctx.globalAlpha = !ego || shown(i) ? 1 : 0.22;
        ctx.beginPath();
        ctx.arc(px(i), py(i),
          Math.min(size * (ego ? 0.01 : 0.016),
            Math.max(1, (size * weight * (ego ? 0.3 : 0.36)) / dep(i))),
          0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function tick() {
      if (panel) {
        const frame = Math.min(
          panel.n_frames - 1,
          Math.max(0, Math.round(video.currentTime * panel.fps)),
        );
        if (frame !== lastFrame) {
          lastFrame = frame;
          for (const c of canvases) drawView(c, frame);
        }
      }
      requestAnimationFrame(tick);
    }

    reveal.addEventListener("click", () => {
      optionsHost.classList.toggle("revealed");
      reveal.textContent = optionsHost.classList.contains("revealed")
        ? "Hide answer"
        : "Show answer";
    });

    new ResizeObserver(resize).observe(root);

    let started = false;
    const load = () => {
      if (started) return;
      started = true;
      fetch(root.dataset.src!)
        .then((r) => r.json())
        .then((data: Panel) => {
          panel = data;
          buildViews(data);
        })
        .catch(() => {});
    };
    let wanted = false;
    const start = () => {
      wanted = true;
      video.preload = "auto";
      void video.play().catch(() => {});
    };
    playBtn.addEventListener("click", start);
    video.addEventListener("click", () => (video.paused ? start() : video.pause()));
    video.addEventListener("play", () => media.classList.add("playing"));
    video.addEventListener("pause", () => media.classList.remove("playing"));

    new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible) {
        load();
        if (wanted) void video.play().catch(() => {});
      } else if (!video.paused) {
        video.pause();
      }
    }, { rootMargin: "200px", threshold: 0 }).observe(video);

    requestAnimationFrame(tick);
  }
</script>
