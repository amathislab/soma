---

<div class="mx-[calc(max(var(--minimum-inline-margin),(100cqw-100rem)/2)-var(--actual-inline-margin))]">
<figure class="table mx-auto my-6 max-w-full min-w-[min(calc(var(--actual-text-width)+8rem),100%)]">
  <div class="overflow-x-auto">
    <table class="not-prose w-full min-w-max border-collapse text-[0.95rem] leading-snug text-zinc-800 tabular-nums dark:text-zinc-200">
      <thead>
        <tr>
          <th rowspan="2" class="px-3 py-1.5 text-left align-bottom font-semibold">Model</th>
          {
            axes.map((axis) => (
              <th
                colspan={axis.tasks.length}
                class="border-l border-zinc-200 px-2 pt-1 pb-1.5 text-center text-[0.85rem] font-semibold text-zinc-700 dark:border-zinc-700 dark:text-zinc-300"
              >
                {axis.name}
              </th>
            ))
          }
          <th rowspan="2" class="border-l border-zinc-200 bg-zinc-50 px-2 py-1.5 text-center align-bottom font-semibold dark:border-zinc-700 dark:bg-zinc-800/50">Avg.</th>
        </tr>
        <tr class="border-b border-zinc-400 dark:border-zinc-500">
          {tasks.map((t, i) => <th class:list={[cellClass(i), "text-[0.8rem] font-semibold text-zinc-500 dark:text-zinc-400"]}>{t}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) =>
            "section" in row ? (
              <tr class="border-y border-zinc-300 bg-zinc-100 dark:border-zinc-600 dark:bg-zinc-800">
                <td colspan={tasks.length + 2} class="px-3 py-1.5 text-center text-[0.95rem] font-semibold text-zinc-600 italic dark:text-zinc-300">
                  {row.section}
                </td>
              </tr>
            ) : (
              <tr
                class:list={[
                  "border-b",
                  row.end ? "border-zinc-300 dark:border-zinc-600" : "border-zinc-100 dark:border-zinc-800",
                  row.italic && "text-zinc-500 italic dark:text-zinc-400",
                ]}
              >
                <td class="px-3 py-1.5 text-left whitespace-nowrap">
                  {row.italic ? (
                    row.name
                  ) : (
                    <span class="flex items-center gap-2">
                      <span class="flex size-4 shrink-0 items-center justify-center">
                        {row.icon && <row.icon width={16} height={16} aria-hidden="true" />}
                      </span>
                      {row.href ? (
                        <a
                          href={row.href}
                          class="text-blue-600 underline decoration-dashed underline-offset-4 hover:text-blue-900 hover:decoration-solid dark:text-blue-200 dark:hover:text-blue-100"
                        >
                          {row.name}
                        </a>
                      ) : (
                        row.name
                      )}
                    </span>
                  )}
                </td>
                {row.cells.map((c, i) =>
                  typeof c === "string" ? (
                    <td class:list={cellClass(i)}>{c}</td>
                  ) : c[1] === "b" ? (
                    <td class:list={cellClass(i)}><strong class="font-bold text-zinc-950 dark:text-white">{c[0]}</strong></td>
                  ) : (
                    <td class:list={cellClass(i)}><u class="underline-offset-2">{c[0]}</u></td>
                  ),
                )}
              </tr>
            ),
          )
        }
      </tbody>
    </table>
  </div>
  <figcaption class="table-caption caption-bottom pt-3 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
    <slot />
  </figcaption>
</figure>
</div>

<style>
  tbody tr {
    transition: background-color 120ms ease;
  }
  tbody tr:hover {
    background-color: rgb(0 0 0 / 0.04);
  }
  :global([data-theme="dark"]) tbody tr:hover {
    background-color: rgb(255 255 255 / 0.06);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) tbody tr:hover {
      background-color: rgb(255 255 255 / 0.06);
    }
  }
</style>
